RPC_URL=https://rpc.testnet.chain.robinhood.com
# WebSocket RPC used for new-block and RandomnessRequested subscriptions.
WS_URL=
CHAIN_ID=46630
# Contract deployment: owner must equal deployer for the configured deployment script.
DEPLOYER_ADDRESS=
OWNER_ADDRESS=
RELAYER_ADDRESS=
DEPLOYER_ACCOUNT=openvrf-mainnet-deployer
REQUEST_FEE_WEI=0
ROUTER_ADDRESS=
# Optional existing contract to whitelist during deployment; no consumer is deployed.
CONSUMER_ADDRESS=
# true relays every consumer on this router, including campaigns authorized after startup.
# false requires CONSUMER_ADDRESS and preserves single-campaign operation.
RELAY_ALL_CONSUMERS=true
# Use the identical ordered list on every instance. Omit for single-wallet operation.
RELAYER_ADDRESSES=
# Increment only during a coordinated stop-all relayer-set migration.
RELAYER_SET_VERSION=1
# Seconds before an unfinished request rotates to the next wallet in the list.
RELAYER_FAILOVER_SECONDS=60
# Cross-wallet transaction lease; must cover receipt timeout plus reconciliation interval.
RELAYER_LEASE_SECONDS=120
START_REQUEST_ID=1
# Set this to the router deployment block to avoid a genesis log backfill.
START_BLOCK=0
# Larger pages accelerate startup recovery. Recurring reconciliation uses EVENT_BLOCK_RANGE.
STARTUP_EVENT_BLOCK_RANGE=100000
MULTICALL_BATCH_SIZE=500
EVENT_BLOCK_RANGE=2000
REORG_LOOKBACK_BLOCKS=1000
RECONCILE_HEAD_LAG_BLOCKS=5
RECONCILE_SECONDS=15
RECEIPT_TIMEOUT_SECONDS=60
RECEIPT_CONFIRMATIONS=2
MAX_REBROADCASTS=5
REBROADCAST_BACKOFF_SECONDS=30
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=30
MAX_REQUEST_SPEND_ETH=0.001
MAX_TOTAL_SPEND_ETH=0.01
MAX_GAS_PRICE_GWEI=2
# PostgreSQL stores the durable queue, signed transactions, nonces, and spending state.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Used by direct Node execution; Compose constructs its container URL from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://openvrf:change-me@127.0.0.1:5432/openvrf
# For direct Node execution, set this in the shell before sourcing this file:
# RELAYER_KEY_FILE=./secrets/relayer-key
